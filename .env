# Settings for the Grewal Tile Gallery bot (my-bot/worker.js).
#
# Cloudflare does not read this file. Copy each line by hand into:
#   Workers & Pages > (your worker) > Settings > Variables and Secrets > Add
# Type "Text" for these lines. Then click Deploy.
#
# The website on Cloudflare Pages (my-bot/site) needs no settings at all:
# it only needs the worker's address as "endpoint" in site/index.html.
#
# LLM_API_KEY is NOT in this file on purpose. Add it in the same Cloudflare
# screen with type "Secret", typing it there yourself. Never put it in any file.

# Groq (backup: LLM_BASE_URL=https://integrate.api.nvidia.com/v1 and LLM_MODEL=moonshotai/kimi-k3)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# "*" while testing. Once the site is live, change it to your Pages address,
# for example https://grewal-tiles.pages.dev (comma-separated if more than one).
ALLOWED_ORIGINS=*

# Optional: Google Sheet for enquiries (the Apps Script web app URL ending in ?key=YOUR_SECRET).
# Leave empty, or delete the line, if you don't use it.
LEAD_WEBHOOK_URL=

# Optional: Telegram alerts. Add TELEGRAM_BOT_TOKEN in Cloudflare as a "Secret", not here.
TELEGRAM_CHAT_ID=
